---
import Home from '@/layouts/Home'
import RecentList from '@/components/Recent'
import Calendar from '@/components/vue/Calendar'
import PageFind from '@/components/PageFind'
import { getArticleData } from '@/server/getters/article'

import github from '../images/github.svg'

// Article collection
const articleData = await getArticleData()

const contacts = [
  {
    icon: github,
    url: 'https://github.com/CGmoke',
    title: 'Github',
  },
]
---

<Home>
  <div class="mb-10">
    <h2 class="font-bold mb-6 text-lg" data-pagefind-ignore>📊 PERECENT TRENDS / 「 近期动态 」</h2>
    <div class="hidden lg:block">
      <div id="skeleton" class="navigation-template bg-frostedGlass dark:bg-markerShadow"></div>
      <div id="calendar" class="w-full overflow-hidden rounded-lg border border-white/10 dark:border-white/5">
        <Calendar client:only="vue" article={articleData} />
      </div>
    </div>
    <div class="w-full mb-6 mt-2 max-w-3xl">
      <div class="navigation bg-frostedGlass dark:bg-markerShadow flex-wrap">
        {
          contacts.map((contact) => {
            return (
              <a class="navigation-a dark:hover:bg-lightGray hover:bg-crystalClear" target="_blank" href={contact.url}>
                <img src={contact.icon.src} width={contact.icon.width} height={contact.icon.height} alt={contact.title} class="w-6" />
              </a>
            )
          })
        }
        <PageFind transition:persist />
      </div>
    </div>
  </div>
  <div data-pagefind-ignore>
    <h2 class="font-bold mt-2 mb-6 text-lg" data-pagefind-ignore>📝 PERECENT ARTICLES/「 近期文章 」</h2>
    <div>
      <RecentList />
    </div>
  </div>
</Home>
