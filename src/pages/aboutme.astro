---
import Home from '@/layouts/Home'
import config from '../config'
---

<Home title="关于我">
  <div class="mx-auto mb-6 text-sm" data-pagefind-ignore>
    <h1 class="text-xl font-medium mb-4 mt-2">关于我</h1>
    <div class="prose-width flex flex-col gap-2">
      <span>嗨！我是沧歌，一个热爱技术与生活的开发者</span>
      <span>从代码到生活，从技术到人文，我乐于在不同领域中寻找乐趣和意义</span>
      <span>这里记录着我的学习笔记、踩坑经历与一些随想，希望能与同好们一起成长</span>
      <span>目前我正专注于提升自己的技术能力，也在探索更多有意思的方向</span>
      <span>如果你对我的博客或文章有任何建议，欢迎通过下面的方式联系我</span>
      <span>
        你可以在<a href="https://github.com/CGmoke" target="_blank">Github</a>上看到更多关于我的动态
      </span>
    </div>
  </div>

  <h2 class="font-bold mb-3 text-md desktop" data-pagefind-ignore>LINKS /「 友链 」</h2>
  <div class="mx-auto text-sm desktop" data-pagefind-ignore>
    <div class="footer-links prose">
      <div>
        {
          config.linkedList.length > 0 ? (
            config.linkedList.map((res: { link: string; label: string }) => (
              <>
                <a class="item" href={res.link} target="_blank" rel="noopener noreferrer">
                  {res.label}
                </a>
                <div class="vertical" />
              </>
            ))
          ) : (
            <span class="text-gray-500">{config.friend}</span>
          )
        }
      </div>
    </div>
  </div>
</Home>
