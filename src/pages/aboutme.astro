---
import Home from '@/layouts/Home'
import config from '../config'

const skills = [
  {
    category: '🤖 机器人开发',
    items: [
      { name: 'ROS2', level: 90, color: 'bg-blue-500' },
      { name: 'Nav2 导航栈', level: 85, color: 'bg-green-500' },
      { name: 'MoveIt2 机械臂', level: 75, color: 'bg-purple-500' },
      { name: 'Gazebo 仿真', level: 80, color: 'bg-orange-500' },
    ]
  },
  {
    category: '💻 编程语言',
    items: [
      { name: 'Python', level: 90, color: 'bg-yellow-500' },
      { name: 'C/C++', level: 80, color: 'bg-blue-600' },
      { name: 'TypeScript', level: 75, color: 'bg-blue-400' },
      { name: 'Rust (学习中)', level: 40, color: 'bg-red-500' },
    ]
  },
  {
    category: '🌐 Web 开发',
    items: [
      { name: 'Vue3 / React', level: 85, color: 'bg-green-400' },
      { name: 'Astro', level: 80, color: 'bg-purple-400' },
      { name: 'Node.js', level: 75, color: 'bg-green-500' },
      { name: 'TailwindCSS', level: 90, color: 'bg-cyan-500' },
    ]
  },
  {
    category: '🛠️ 工具 & 其他',
    items: [
      { name: 'Docker', level: 75, color: 'bg-blue-500' },
      { name: 'Git / GitHub', level: 85, color: 'bg-gray-600' },
      { name: 'Linux', level: 80, color: 'bg-yellow-600' },
      { name: 'Blender', level: 50, color: 'bg-orange-400' },
    ]
  }
]

const timeline = [
  {
    year: '2025',
    title: '博客上线',
    description: '搭建个人博客，记录技术学习和生活点滴。开始深入研究 ROS2 生态系统。',
    color: 'bg-pink-500',
    icon: '🚀'
  },
  {
    year: '2024',
    title: '接触机器人开发',
    description: '开始学习 ROS1/ROS2，参与移动机器人项目，负责导航算法调试。',
    color: 'bg-blue-500',
    icon: '🤖'
  },
  {
    year: '2023',
    title: 'Web 全栈探索',
    description: '学习现代前端框架 Vue3、React，开始独立完成 Web 项目开发。',
    color: 'bg-green-500',
    icon: '🌐'
  },
  {
    year: '2022',
    title: '编程入门',
    description: '从 C 语言开始，逐步接触 Python、数据结构与算法，打开编程世界的大门。',
    color: 'bg-purple-500',
    icon: '📚'
  }
]

const projects = [
  {
    title: 'ROS2 移动机器人导航系统',
    description: '基于 Nav2 的自主移动机器人导航方案，集成 SLAM 建图、路径规划、避障等功能。',
    tags: ['ROS2', 'Nav2', 'SLAM', 'Python'],
    link: 'https://github.com/CGmoke',
    color: 'from-blue-500 to-cyan-500',
    icon: '🤖'
  },
  {
    title: '个人博客系统',
    description: '基于 Astro + Vue3 构建的静态博客，支持 RSS、搜索、暗色主题、响应式设计。',
    tags: ['Astro', 'Vue3', 'TailwindCSS'],
    link: 'https://github.com/CGmoke/CGmoke.github.io',
    color: 'from-purple-500 to-pink-500',
    icon: '📝'
  },
  {
    title: '机械臂运动规划 Demo',
    description: '基于 MoveIt2 的六自由度机械臂运动规划项目，支持关节空间和笛卡尔空间规划。',
    tags: ['ROS2', 'MoveIt2', 'C++'],
    link: 'https://github.com/CGmoke',
    color: 'from-orange-500 to-red-500',
    icon: '🦾'
  }
]
---

<Home title="关于我">
  <div class="mx-auto mb-8 text-sm" data-pagefind-ignore>
    <h1 class="text-xl font-medium mb-4 mt-2">👋 关于我</h1>
    <div class="bg-frostedGlass dark:bg-markerShadow backdrop-blur-md rounded-lg p-6 border border-white/10 mb-6">
      <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
        <div class="flex-shrink-0">
          <img
            src="https://avatars.githubusercontent.com/u/202474769?v=4"
            alt="头像"
            class="w-32 h-32 rounded-full border-4 border-white/30 shadow-lg"
          />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h2 class="text-2xl font-bold mb-2 defaultColor">沧歌</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4 italic">「{config.signature}」</p>
          <div class="space-y-2 defaultColor">
            <p>嗨！我是沧歌，一个热爱技术与生活的开发者 🧑‍💻</p>
            <p>专注于机器人开发、Web 全栈技术探索。从代码到生活，从技术到人文，我乐于在不同领域中寻找乐趣和意义。</p>
            <p>这里记录着我的学习笔记、踩坑经历与一些随想，希望能与同好们一起成长 ✨</p>
          </div>
          <div class="mt-4 flex flex-wrap gap-2 justify-center md:justify-start">
            <a
              href="https://github.com/CGmoke"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white rounded-lg text-sm transition-colors"
            >
              <span>🐙</span> GitHub
            </a>
            <a
              href="/subscribe"
              class="inline-flex items-center gap-2 px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-sm transition-colors"
            >
              <span>📡</span> RSS 订阅
            </a>
            <a
              href="/article"
              class="inline-flex items-center gap-2 px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg text-sm transition-colors"
            >
              <span>📚</span> 浏览文章
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto mb-8 text-sm" data-pagefind-ignore>
    <h2 class="font-bold mb-4 text-lg flex items-center gap-2 defaultColor">
      <span>💡</span> 技能树
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        skills.map((group) => (
          <div class="bg-frostedGlass dark:bg-markerShadow backdrop-blur-md rounded-lg p-5 border border-white/10">
            <h3 class="font-bold mb-4 defaultColor">{group.category}</h3>
            <div class="space-y-3">
              {
                group.items.map((skill) => (
                  <div>
                    <div class="flex justify-between mb-1 text-sm defaultColor">
                      <span>{skill.name}</span>
                      <span class="text-gray-500 dark:text-gray-400">{skill.level}%</span>
                    </div>
                    <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                      <div
                        class={`h-full ${skill.color} rounded-full transition-all duration-1000`}
                        style={`width: ${skill.level}%`}
                      ></div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mx-auto mb-8 text-sm" data-pagefind-ignore>
    <h2 class="font-bold mb-4 text-lg flex items-center gap-2 defaultColor">
      <span>📅</span> 成长时间线
    </h2>
    <div class="bg-frostedGlass dark:bg-markerShadow backdrop-blur-md rounded-lg p-6 border border-white/10">
      <div class="relative">
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 transform md:-translate-x-1/2"></div>
        <div class="space-y-8">
          {
            timeline.map((item, index) => (
              <div class:list={['relative flex flex-col md:flex-row gap-4 md:gap-0', index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse']}>
                <div class="hidden md:block md:w-1/2"></div>
                <div class={`absolute left-4 md:left-1/2 w-8 h-8 rounded-full ${item.color} flex items-center justify-center transform -translate-x-1/2 shadow-lg z-10 text-sm`}>
                  {item.icon}
                </div>
                <div class:list={['ml-14 md:ml-0 md:w-1/2', index % 2 === 0 ? 'md:pl-12 md:text-left' : 'md:pr-12 md:text-right']}>
                  <div class="bg-white/50 dark:bg-black/30 rounded-lg p-4 hover:shadow-lg transition-shadow">
                    <div class="text-xs text-gray-500 dark:text-gray-400 mb-1 font-mono">{item.year}</div>
                    <h4 class="font-bold mb-2 defaultColor">{item.title}</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-300">{item.description}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto mb-8 text-sm" data-pagefind-ignore>
    <h2 class="font-bold mb-4 text-lg flex items-center gap-2 defaultColor">
      <span>🚀</span> 项目展示
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        projects.map((project) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-frostedGlass dark:bg-markerShadow backdrop-blur-md rounded-lg p-5 border border-white/10 hover:shadow-xl hover:scale-[1.02] transition-all duration-300 block"
          >
            <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${project.color} flex items-center justify-center text-2xl mb-4 group-hover:rotate-6 transition-transform`}>
              {project.icon}
            </div>
            <h4 class="font-bold mb-2 defaultColor group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">
              {project.title}
            </h4>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-1">
              {
                project.tags.map((tag) => (
                  <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full">
                    {tag}
                  </span>
                ))
              }
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div class="mx-auto mb-8 text-sm" data-pagefind-ignore>
    <h2 class="font-bold mb-4 text-lg flex items-center gap-2 defaultColor">
      <span>📮</span> 联系我
    </h2>
    <div class="bg-frostedGlass dark:bg-markerShadow backdrop-blur-md rounded-lg p-6 border border-white/10">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <a
          href="https://github.com/CGmoke"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-4 rounded-lg bg-white/50 dark:bg-black/30 hover:bg-white/70 dark:hover:bg-black/50 transition-all"
        >
          <span class="text-3xl mb-2">🐙</span>
          <div class="font-bold text-sm defaultColor">GitHub</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">@CGmoke</div>
        </a>
        <a
          href="/rss.xml"
          class="flex flex-col items-center p-4 rounded-lg bg-white/50 dark:bg-black/30 hover:bg-white/70 dark:hover:bg-black/50 transition-all"
        >
          <span class="text-3xl mb-2">📡</span>
          <div class="font-bold text-sm defaultColor">RSS</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">订阅更新</div>
        </a>
        <a
          href="/subscribe"
          class="flex flex-col items-center p-4 rounded-lg bg-white/50 dark:bg-black/30 hover:bg-white/70 dark:hover:bg-black/50 transition-all"
        >
          <span class="text-3xl mb-2">📬</span>
          <div class="font-bold text-sm defaultColor">订阅中心</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">RSS & 专栏</div>
        </a>
        <a
          href="https://github.com/CGmoke/CGmoke.github.io/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-4 rounded-lg bg-white/50 dark:bg-black/30 hover:bg-white/70 dark:hover:bg-black/50 transition-all"
        >
          <span class="text-3xl mb-2">💬</span>
          <div class="font-bold text-sm defaultColor">留言反馈</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Issues</div>
        </a>
      </div>
      <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700 text-center defaultColor">
        <p class="mb-2">💬 如果你对我的博客或文章有任何建议，欢迎随时联系我！</p>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          「 读万卷书，行万里路，写万行代码 」
        </p>
      </div>
    </div>
  </div>

  <h2 class="font-bold mb-3 text-md desktop" data-pagefind-ignore>LINKS /「 友链 」</h2>
  <div class="mx-auto text-sm desktop" data-pagefind-ignore>
    <div class="footer-links prose">
      <div>
        {
          config.linkedList.length > 0 ? (
            config.linkedList.map((res: { link: string; label: string }) => (
              <>
                <a class="item" href={res.link} target="_blank" rel="noopener noreferrer">
                  {res.label}
                </a>
                <div class="vertical" />
              </>
            ))
          ) : (
            <span class="text-gray-500">{config.friend}</span>
          )
        }
      </div>
    </div>
  </div>
</Home>
