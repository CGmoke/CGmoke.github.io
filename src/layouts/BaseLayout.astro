---
import '@/style/app'
import ProviderTheme from '@/components/ProviderTheme'
import FixedText from '@/components/FixedText'
import StarryBackground from '@/components/StarryBackground'
import { ViewTransitions } from 'astro:transitions'
---

<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content="沧歌的博客 —— 记录学习、生活与思考的个人博客" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#dedede" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="preconnect" href="https://at.alicdn.com" crossorigin />
    <title>{Astro.props.title}</title>
    <meta property="og:site_name" content={"沧歌的博客"} />
    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta
      property="og:image"
      content={Astro.props.ogImage || new URL('/ogImage.jpg', Astro.site)}
    />
    <meta
      property="og:description"
      content={Astro.props.ogDescription || '沧歌的博客 —— 记录学习、生活与思考。'}
    />
    <meta property="og:type" content={Astro.props.ogType || 'website'} />
    <ProviderTheme />
    <ViewTransitions />
  </head>

  <body
    class="bg-snowfallWhite text-stone-950 dark:bg-[#0a0a0f] dark:text-snowfallWhite w-full h-full transition-colors duration-500"
  >
    <StarryBackground />
    <slot />
    <FixedText />
    <button id="back-to-top" aria-label="返回顶部" class="back-to-top" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 15l-6-6-6 6" />
      </svg>
    </button>
  </body>
</html>

<style is:global>
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 30;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: none;
    cursor: pointer;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
  }

  .back-to-top.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(96, 165, 250, 0.4);
  }

  @media (min-width: 1280px) {
    .back-to-top {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('back-to-top')
    if (!btn) return

    const onScroll = () => {
      btn.classList.toggle('show', window.scrollY > 400)
    }

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })

    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  })
</script>
