---
import config, { type RoadmapItem, type RoadmapStatus } from '../config'

const statusMeta: Record<
  RoadmapStatus,
  { label: string; icon: string; badge: string; accent: string; bar: string; text: string; dot: string }
> = {
  doing: {
    label: '进行中',
    icon: '🚀',
    badge: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/25',
    accent: 'bg-blue-500',
    bar: 'bg-gradient-to-r from-blue-500 to-cyan-400',
    text: 'text-blue-600 dark:text-blue-400',
    dot: 'bg-blue-500',
  },
  todo: {
    label: '规划中',
    icon: '📅',
    badge: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/25',
    accent: 'bg-purple-500',
    bar: 'bg-gradient-to-r from-purple-500 to-pink-400',
    text: 'text-purple-600 dark:text-purple-400',
    dot: 'bg-purple-500',
  },
  done: {
    label: '已完成',
    icon: '✅',
    badge: 'bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/25',
    accent: 'bg-green-500',
    bar: 'bg-green-500',
    text: 'text-green-600 dark:text-green-400',
    dot: 'bg-green-500',
  },
}

const statusOrder: RoadmapStatus[] = ['doing', 'todo', 'done']
const items = [...(config.roadmap as RoadmapItem[])].sort(
  (a, b) => statusOrder.indexOf(a.status) - statusOrder.indexOf(b.status)
)

const groups = statusOrder.map((status) => ({
  status,
  meta: statusMeta[status],
  items: items.filter((item) => item.status === status),
}))
---

<div class="roadmap-root" data-pagefind-ignore>
  {
    groups.map((group) => {
      if (group.items.length === 0) return null
      return (
        <div class="roadmap-group">
          <div class="roadmap-group-header">
            <span class={`inline-flex items-center gap-1.5 text-sm font-bold ${group.meta.text}`}>
              <span class={`inline-block w-2 h-2 rounded-full ${group.meta.dot}`} />
              {group.meta.icon} {group.meta.label}
            </span>
            <span class="text-xs text-gray-400 dark:text-gray-500">{group.items.length} 项</span>
          </div>

          <div class="roadmap-grid">
            {
              group.items.map((item) => {
                const meta = statusMeta[item.status]
                const isDone = item.status === 'done'
                return (
                  <article class={`roadmap-card surface-card ${isDone ? 'is-done' : ''}`}>
                    <span class={`absolute left-0 top-0 bottom-0 w-[3px] rounded-l ${meta.accent}`} />

                    <header class="roadmap-card-header">
                      <h3 class="roadmap-card-title defaultColor">
                        {item.link ? (
                          <a
                            href={item.link}
                            target={item.link.startsWith('http') ? '_blank' : undefined}
                            rel={item.link.startsWith('http') ? 'noopener' : undefined}
                          >
                            {item.title}
                          </a>
                        ) : (
                          item.title
                        )}
                      </h3>
                      <span
                        class={`inline-flex items-center gap-1 flex-shrink-0 text-xs px-2 py-0.5 rounded-full border ${meta.badge}`}
                      >
                        {meta.icon} {meta.label}
                      </span>
                    </header>

                    <p class="roadmap-card-desc">{item.description}</p>

                    {item.status === 'doing' && typeof item.progress === 'number' ? (
                      <div class="roadmap-progress">
                        <div class="roadmap-progress-meta">
                          <span>进度</span>
                          <span class={`font-bold ${meta.text}`}>{item.progress}%</span>
                        </div>
                        <div class="roadmap-progress-bar">
                          <div class={`h-full rounded-full ${meta.bar}`} style={`width: ${item.progress}%`} />
                        </div>
                      </div>
                    ) : (
                      <div class="roadmap-progress roadmap-progress--placeholder">
                        <div class="roadmap-progress-meta">
                          <span>{item.status === 'done' ? '完成时间' : '预计时间'}</span>
                          <span class={`font-bold ${meta.text}`}>
                            {item.date ?? (item.status === 'done' ? '—' : '待定')}
                          </span>
                        </div>
                        <div class="roadmap-progress-bar roadmap-progress-bar--placeholder" />
                      </div>
                    )}

                    <footer class="roadmap-card-footer">
                      <div class="roadmap-card-tags">
                        {item.tags?.map((tag) => (
                          <span class="roadmap-card-tag">#{tag}</span>
                        ))}
                      </div>
                      {item.date && item.status !== 'doing' && (
                        <span class="roadmap-card-date">{item.date}</span>
                      )}
                    </footer>
                  </article>
                )
              })
            }
          </div>
        </div>
      )
    })
  }
</div>

<style lang="scss">
  .roadmap-root {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .roadmap-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .roadmap-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 0.25rem;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.75rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .roadmap-card {
    position: relative;
    padding: 1rem 1.125rem 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    &.is-done {
      opacity: 0.75;
      filter: saturate(0.8);
    }

    &.is-done:hover {
      opacity: 0.88;
      filter: saturate(1);
    }
  }

  .roadmap-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .roadmap-card-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0;

    a {
      transition: color 0.2s;
    }

    a:hover {
      color: #3b82f6;
    }

    html.dark & a:hover {
      color: #60a5fa;
    }
  }

  .roadmap-card-desc {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: #525252;
    margin: 0;
    /* 限制最多 2 行，保证卡片高度稳定 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    html.dark & {
      color: #a3a3a3;
    }
  }

  .roadmap-progress {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .roadmap-progress--placeholder {
    .roadmap-progress-bar {
      background: repeating-linear-gradient(
        90deg,
        rgba(160, 160, 160, 0.3) 0,
        rgba(160, 160, 160, 0.3) 4px,
        transparent 4px,
        transparent 8px
      );
    }
  }

  .roadmap-progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: #737373;

    html.dark & {
      color: #a3a3a3;
    }
  }

  .roadmap-progress-bar {
    height: 6px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.08);
    overflow: hidden;

    html.dark & {
      background: rgba(255, 255, 255, 0.12);
    }

    &--placeholder {
      height: 3px;
    }
  }

  .roadmap-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.375rem;
    border-top: 1px dashed rgba(160, 160, 160, 0.3);
  }

  .roadmap-card-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .roadmap-card-tag {
    font-size: 0.6875rem;
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    color: #6b7280;

    html.dark & {
      background: rgba(255, 255, 255, 0.1);
      color: #9ca3af;
    }
  }

  .roadmap-card-date {
    font-size: 0.6875rem;
    color: #9ca3af;
    flex-shrink: 0;
  }
</style>
