<button
  id="theme-toggle-btn"
  class="relative h-9 w-9 rounded-lg bg-white/50 dark:bg-black/30 hover:bg-white/70 dark:hover:bg-black/50 transition-all duration-300 flex items-center justify-center border border-white/20 dark:border-white/10 shadow-sm hover:shadow-md group"
  aria-label="切换主题"
  title="切换主题"
>
  <span class="sun-icon absolute transition-all duration-300 text-yellow-500 group-hover:rotate-180">
    <i class="iconfont icon-sun text-lg"></i>
  </span>
  <span class="moon-icon absolute transition-all duration-300 text-blue-300 group-hover:-rotate-12">
    <i class="iconfont icon-moon text-lg"></i>
  </span>
</button>

<style>
  #theme-toggle-btn .sun-icon {
    opacity: 0;
    transform: scale(0) rotate(-90deg);
  }
  #theme-toggle-btn .moon-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  html.dark #theme-toggle-btn .sun-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  html.dark #theme-toggle-btn .moon-icon {
    opacity: 0;
    transform: scale(0) rotate(90deg);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('theme-toggle-btn')
    if (!btn || btn.dataset.bound) return
    btn.dataset.bound = 'true'

    function currentTheme(): 'light' | 'dark' {
      return document.documentElement.classList.contains('dark') ? 'dark' : 'light'
    }

    btn.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark'
      // @ts-ignore
      if (window.__setTheme) {
        // @ts-ignore
        window.__setTheme(next)
      } else {
        document.documentElement.classList.toggle('dark', next === 'dark')
        localStorage.setItem('theme', next)
      }
      document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: next } }))
    })
  })
</script>
